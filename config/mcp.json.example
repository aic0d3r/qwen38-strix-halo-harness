{
  "mcpServers": {
    "serena": {
      "command": "~/.local/bin/serena",
      "args": ["start-mcp-server", "--project-from-cwd"],
      "exposure": "codemode",
      "toolExposure": {
        "activate_project": "direct",
        "find_symbol": "direct",
        "get_symbols_overview": "direct",
        "find_referencing_symbols": "direct",
        "search_for_pattern": "direct",
        "get_diagnostics_for_file": "direct",
        "replace_symbol_body": "direct",
        "insert_after_symbol": "direct",
        "rename_symbol": "direct",
        "safe_delete_symbol": "hidden",
        "delete_memory": "hidden",
        "rename_memory": "hidden",
        "edit_memory": "hidden",
        "execute_shell_command": "hidden",
        "create_text_file": "hidden",
        "read_file": "hidden",
        "list_dir": "hidden",
        "find_file": "hidden",
        "open_dashboard": "hidden",
        "get_current_config": "hidden",
        "onboarding": "hidden",
        "initial_instructions": "hidden",
        "*": "codemode"
      },
      "description": "Serena LSP toolbox: symbol-precise code navigation, diagnostics, and edits (activate_project first)"
    },
    "ddg": {
      "command": "uvx",
      "args": ["--with", "duckduckgo-mcp-server[browser]", "duckduckgo-mcp-server"],
      "enabled": true,
      "exposure": "hidden",
      "toolExposure": {
        "search": "direct",
        "fetch_content": "direct",
        "expand_link": "direct",
        "*": "hidden"
      },
      "env": { "DDG_PARSE_MODE": "markdown" },
      "description": "DuckDuckGo web search + page reading (no API key; lightweight Jina alternative)"
    },
    "jina": {
      "url": "https://mcp.jina.ai/v1",
      "headers": { "Authorization": "${JINA_API_KEY}" },
      "enabled": false,
      "description": "Jina web search and page reading (enable via /mcp; needs the key file)"
    },
    "semble": {
      "command": "uvx",
      "args": ["--from", "semble[mcp]==0.6.2", "semble"],
      "exposure": "hidden",
      "toolExposure": { "search": "direct", "find_related": "direct", "*": "hidden" },
      "description": "Semble instant semantic code search (local or remote git repos; replaced the NPU rag pipeline - A/B 17/18 vs 13/18, 2026-10-10)"
    }
  }
}
