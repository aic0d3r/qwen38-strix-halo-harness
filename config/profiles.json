{
  "_doc": "Engine + model-family defaults used by ./harness. Engines are probed in order; models.* are regexes on the served model id (first match wins), merged over `default`.",
  "engines": {
    "halogen":  { "port": 8731,  "probe": "/health",     "provider": "halogen", "npu": true,  "managed": true,  "note": "Strix Halo NPU+GPU engine; provisioned by setup.sh --halogen",
                 "hide": "^(decider|qwen3-embedding|qwen3guard|qwen3-reranker)",
                 "script": "server/start-halogen.sh", "loses": "nothing",
                 "update": { "have": "pin server/start-halogen.sh HALOGEN_IMAGE_TAG", "latest": "ghcr:peonist-ai/halogen-flash-server",
                             "how": "./setup.sh --halogen-upgrade (restarts halogen, checks it, pins on success, rolls back on failure)" } },
    "strata":   { "port": 8080,  "probe": "/v1/models",  "provider": "strata",  "npu": false, "managed": false, "loses": "NPU tools (guard, triage, dedup)", "note": "NVIDIA/AMD desktop GPUs",
                 "start": "./setup.sh installs and starts it (or run scripts/install-strata.sh, then server/start-strata.sh)",
                 "script": "server/start-strata.sh",
                 "update": { "have": "dir server/start-strata.sh", "latest": "gh:Niko1221/Strata", "how": "scripts/upgrade-strata.sh (runs Strata's update.sh, restarts it, checks it, rolls back on failure)" } },
    "gufo":     { "port": 8080,  "probe": "/v1/models",  "provider": "gufo",    "npu": false, "managed": false,
                 "note": "shares :8080 with strata/llama.cpp; told apart by owned_by=gufo in /v1/models",
                 "start": "stop halogen first, then run server/start-gufo-flashnext.sh",
                 "script": "server/start-gufo-flashnext.sh", "loses": "NPU tools (guard, triage, dedup)",
                 "update": { "have": "pin server/start-gufo-flashnext.sh GUFO_VERSION", "latest": "ghcr:gufo-org/toolboxes/gufo-runtime",
                             "how": "scripts/upgrade-gufo.sh (restarts gufo, checks it, pins on success, rolls back on failure)" } },
    "llamacpp": { "port": 8080,  "probe": "/health",     "provider": "llamacpp","npu": false, "managed": false, "loses": "NPU tools (guard, triage, dedup)", "note": "llama-server; see docs/LLAMACPP.md",
                 "update": { "have": "/props build_info", "latest": "gh:ggml-org/llama.cpp", "how": "rebuild or download llama.cpp {new}" } },
    "vllm":     { "port": 8000,  "probe": "/v1/models",  "provider": "vllm",    "npu": false, "managed": false, "loses": "NPU tools (guard, triage, dedup)",
                 "update": { "have": "/version version", "latest": "gh:vllm-project/vllm", "how": "pip install -U vllm (or pull the new vllm image)" } },
    "ollama":   { "port": 11434, "probe": "/v1/models",  "provider": "ollama",  "npu": false, "managed": false, "loses": "NPU tools (guard, triage, dedup)",
                 "update": { "have": "/api/version version", "latest": "gh:ollama/ollama", "how": "re-run the ollama installer or update it with your package manager" } },
    "lmstudio": { "port": 1234,  "probe": "/v1/models",  "provider": "lmstudio","npu": false, "managed": false, "loses": "NPU tools (guard, triage, dedup)" }
  },
  "recommend": {
    "_doc": "Hardware -> engine/quant/context table behind ./harness recommend. gib = size of the shards on unsloth/Qwen3.8-Flash-Next-GGUF (best first); only gufo reads the quant (halogen and Strata ship one fixed weight set here). Anything not measured on a Strix Halo 124 GB box is marked untested.",
    "quants": [
      { "name": "UD-Q5_K_XL", "gib": 147.4 },
      { "name": "UD-Q4_K_XL", "gib": 103.7 },
      { "name": "UD-Q3_K_XL", "gib": 83.3 },
      { "name": "UD-IQ3_XXS", "gib": 77.9 }
    ],
    "extras_gb": 4,
    "ctx_tiers": [ { "spare_gb": 14, "ctx": 65536 }, { "spare_gb": 8, "ctx": 32768 } ],
    "halogen_min_ram_gb": 110, "strata_min_gb": 72, "strata_order": ["flash-next-iq3_s", "flash-next-iq3_xxs", "flash-next-iq2_xs", "flash-next-q2_0", "qwen36-q4"], "halogen_download_gb": 124
  },
  "catalog": {
    "_doc": "Models the wizard can set up, one saved answer (harness-model). engines = who can load it; halogen always serves its own Flash-Next checkpoint and ignores the answer. strata = [family, size] for Strata's `setup.sh --family F --model SIZE` (it downloads the files itself); run = the start script that setup writes; ram_gb = RAM Strata's docs say to plan for (experts + ~10 GB); download_gb = what setup fetches. Sizes are Strata's MODELS.md / DETAILS.md and the Hugging Face repos; none of the non-default rows has run here.",
    "flash-next": { "label": "Qwen3.8-Flash-Next, Unsloth UD-Q4_K_XL (stock or abliterated)", "engines": ["gufo", "strata"] },
    "flash-next-iq3_s":   { "label": "Qwen3.8-Flash-Next, ISTA IQ3_S (matches the full model on Strata's tests)", "engines": ["strata"], "strata": ["qwen", "IQ3_S"],   "run": "run-iq3_s.sh",   "ram_gb": 60, "download_gb": 84 },
    "flash-next-iq3_xxs": { "label": "Qwen3.8-Flash-Next, ISTA IQ3_XXS", "engines": ["strata"], "strata": ["qwen", "IQ3_XXS"], "run": "run-iq3_xxs.sh", "ram_gb": 53, "download_gb": 76 },
    "flash-next-iq2_xs":  { "label": "Qwen3.8-Flash-Next, ISTA IQ2_XS", "engines": ["strata"], "strata": ["qwen", "IQ2_XS"],  "run": "run-iq2_xs.sh",  "ram_gb": 46, "download_gb": 68 },
    "flash-next-q2_0":    { "label": "Qwen3.8-Flash-Next, ISTA Q2_0 (smallest, fastest)", "engines": ["strata"], "strata": ["qwen", "Q2_0"],    "run": "run-q2_0.sh",    "ram_gb": 44, "download_gb": 66 },
    "qwen36-q4": { "label": "Qwen3.6-35B-A3B, UD-Q4_K_XL (small MoE, runs on 32 GB RAM)", "engines": ["strata"], "strata": ["qwen36", "UD-Q4_K_XL"], "run": "run-qwen36-ud-q4_k_xl.sh", "ram_gb": 32, "download_gb": 24 },
    "qwen36-q6": { "label": "Qwen3.6-35B-A3B, UD-Q6_K_XL", "engines": ["strata"], "strata": ["qwen36", "UD-Q6_K_XL"], "run": "run-qwen36-ud-q6_k_xl.sh", "ram_gb": 44, "download_gb": 34 },
    "qwen36-q8": { "label": "Qwen3.6-35B-A3B, Q8_0", "engines": ["strata"], "strata": ["qwen36", "Q8_0"], "run": "run-qwen36-q8_0.sh", "ram_gb": 52, "download_gb": 39 },
    "qwen38-27b": { "label": "Qwen3.8 27B dense, UD-Q4_K_XL + DFlash2 draft (gufo, Strix Halo)", "engines": ["gufo"], "download_gb": 20 }
  },
  "models": {
    "default": {
      "reasoning": false, "maxTokens": 8192, "reserveTokens": 16384,
      "samplingParams": { "temperature": 0.7, "top_p": 0.95 }
    },
    "qwen3": {
      "match": "qwen3|qwen-3",
      "reasoning": true,
      "compat": { "thinkingFormat": "chat-template",
                  "chatTemplateKwargs": { "reasoning_effort": { "$var": "thinking.effort" }, "enable_thinking": { "$var": "thinking.enabled" } } },
      "thinkingLevelMap": { "minimal": null, "low": "low", "medium": "medium", "high": "xhigh", "xhigh": null, "max": null },
      "samplingParams": { "temperature": 1.0, "top_p": 0.95, "top_k": 20, "min_p": 0.0 }
    },
    "deepseek-r1": {
      "match": "deepseek.*r1|r1-distill",
      "reasoning": true,
      "samplingParams": { "temperature": 0.6, "top_p": 0.95 }
    },
    "gpt-oss": {
      "match": "gpt-oss",
      "reasoning": true,
      "samplingParams": { "temperature": 1.0, "top_p": 1.0 }
    },
    "llama": { "match": "llama|mistral|gemma|phi", "samplingParams": { "temperature": 0.6, "top_p": 0.9 } }
  }
}
